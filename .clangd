# C:\Users\<username>\AppData\Local\clangd\config.yaml
# ======================================================================
# .clangd
CompileFlags:
  # 添加全局编译选项（如 C++ 标准）
  Add: [-xc++, -std=c++17, -I/usr/include, -I./include]

# 如果你有 compile_commands.json，通常不需要额外配置路径
# 但若缺失，可通过 FallbackFlags 提供默认编译参数
If:
  PathMatch: .*\.cpp$
  CompileFlags:
    Add: [-std=c++20]

# ======================================================================
Diagnostics:
  Suppress: [unused-variable, unused-parameter]  # 可选：抑制某些警告

# ======================================================================
Index:
  Background: Build             # 后台构建索引，提升跳转/引用速度

# ======================================================================
Hover:
  ShowAKA: true                 # 悬停时显示 typedef 别名等信息

# ======================================================================
InlayHints:
  Enabled: true                 # 显示类型提示（如变量类型、参数名）